# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
SOURCE_CHANNEL_ID=@source_channel_or_-100123456789 # Откуда берем новости (рекомендуется ID вида -100...)
TARGET_CHANNEL_ID=@target_channel_or_-100123456789 # Куда публикуем
TARGET_MESSAGE_THREAD_ID=2  # ID подгруппы (топика) для публикации по умолчанию (например: 2)
# ID подгрупп для автоматической классификации (если не задан, используется TARGET_MESSAGE_THREAD_ID):
# 1 Важные Новости и Налоги
TOPIC_1_THREAD_ID=15
# 2 ВНЖ и Амнистия 2026, Гражданство
TOPIC_2_THREAD_ID=28
# 3 Жизнь и История (Сюда попадают новости без категории)
TOPIC_3_THREAD_ID=42
# 4 Учим Испанский
TOPIC_4_THREAD_ID=55
# 5 Туризм и Рестораны
TOPIC_5_THREAD_ID=70
# 6 Семья и Здоровье
TOPIC_6_THREAD_ID=88

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Admin User ID (for management commands)
ADMIN_USER_ID=your_telegram_user_id

# Publishing Schedule (hours in 24h format, comma-separated)
PUBLISH_SCHEDULE=8,12,16,20

# Urgent Keywords (for immediate publishing, comma-separated)
URGENT_KEYWORDS=молния,breaking

# Article Writing Style
# Available styles: informative, ironic, cynical, playful, mocking
# Default: informative
ARTICLE_STYLE=informative

# Other Settings
MAX_ARTICLES_PER_RUN=5
CHECK_INTERVAL=60

# Дата начала мониторинга (формат: YYYY-MM-DD HH:MM:SS)
# Если оставить пустым, бот будет собирать только НОВЫЕ сообщения с момента своего запуска
MONITOR_FROM_DATE=

# Flask & Webhook Settings (only for webhook mode)
# Запуск: python app.py webhook
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Railway автоматически устанавливает переменную PORT, не нужно указывать вручную
# Для локальной разработки используется FLASK_PORT=5000
# WEBHOOK_URL должен быть HTTPS адресом вашего сервера (без пути)
# Для Railway: https://your-app-name.up.railway.app
WEBHOOK_URL=https://your-domain.com
# Путь для обработки webhook (по умолчанию: /webhook)
WEBHOOK_PATH=/webhook

# PostgreSQL Database Configuration (Aiven or other)
# Option 1: Full DATABASE_URL (recommended for Aiven)
# Example: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@your-aiven-host.aivencloud.com:12345/defaultdb?sslmode=require

# Option 2: Separate parameters (used if DATABASE_URL is not set)
# DB_HOST=your-aiven-host.aivencloud.com
# DB_PORT=12345
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your_password_here
# DB_SSLMODE=require
